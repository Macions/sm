{
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"moduleResolution": "Node16",
		"rootDir": ".",
		"outDir": "./dist",
		"strict": true,
		"types": [
			"node"
		],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true
	},
	"include": [
		"src/**/*",
		"prisma.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}