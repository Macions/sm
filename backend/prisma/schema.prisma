generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int                 @id @default(autoincrement())
  username                  String              @unique(map: "username") @db.VarChar(50)
  email                     String?             @unique(map: "email") @db.VarChar(100)
  password_hash             String              @db.VarChar(255)
  first_name                String              @db.VarChar(50)
  last_name                 String              @db.VarChar(50)
  is_active                 Boolean?            @default(true)
  created_at                DateTime            @default(now()) @db.Timestamp(0)
  team                      String?             @db.VarChar(100)
  status                    String?             @default("active") @db.VarChar(50)
  previous_status           String?             @default("active") @db.VarChar(50)
  province                  String?             @db.VarChar(100)
  phone                     String?             @db.VarChar(20)
  avatar                    String?             @db.VarChar(255)
  functional_role           String?             @db.VarChar(100)
  role_id                   Int?
  join_date                 DateTime?           @db.Date
  is_trial                  Boolean?            @default(false)
  attendance_percentage     Decimal?            @default(92.00) @db.Decimal(5, 2)
  form_data                 String?             @db.LongText
  lastContributionPaidAt    DateTime?
  contributionStatus        ContributionStatus? @default(PENDING)
  contributionOverdueMonths Int                 @default(0)
  pillars                   String?             @db.VarChar(255)
  google_calendar_token String?              @db.Text
  ratedTasks                Task[]              @relation("TaskRatedBy")
  contributions         Contribution[]
  contentCreator        ContentCreator?
  guides                guide[]
  ideaVotes             IdeaVote[]
  leaveComments         LeaveComment[]
  leaves                Leave[]
  materials             Material[]
  mediaContacts         MediaContact[]
  access                MemberAccess[]
  items                 MemberItem[]
  notifications         Notification[]
  onboarding_data       onboarding_data[]
  projects              Project[]
  publications          Publication[]
  refresh_tokens        refresh_tokens[]
  socialMediaCreator    SocialMediaCreator?
  socialMediaMember     SocialMediaMember?
  socialTasks           SocialTask[]
  task                  task[]
  taskAssignees         TaskAssignee[]
  task_attachments      task_attachments[]
  taskComments          TaskComment[]
  assignedTasks         Task[]               @relation("assignedTasks")
  createdTasks          Task[]               @relation("createdTasks")
  team_members          TeamMember[]
  user_notifications    user_notifications[]
  roles                 roles?               @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "users_ibfk_1")
  vacancies             Vacancy[]
  vacancyApplications   VacancyApplication[]

  @@index([role_id], map: "idx_users_role_id")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model SocialMediaCreator {
  id           Int      @id @default(autoincrement())
  user_id      Int      @unique
  availability String   @db.Text
  experience   String   @default("none") @db.VarChar(50)
  topics       String?  @db.LongText
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_social_media_creators_user_id")
  @@map("social_media_creators")
}

model Project {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  pillar         String?   @db.VarChar(100)
  coordinator_id Int?
  team           String?   @db.Text
  status         String?   @default("planning") @db.VarChar(50)
  estimated_end  DateTime? @db.Date
  created_at     DateTime  @default(now()) @db.Timestamp(0)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamp(0)
  is_active      Int?      @default(1) @db.TinyInt
  users          User?     @relation(fields: [coordinator_id], references: [id], onUpdate: Restrict, map: "projects_ibfk_1")
  tasks          Task[]

  @@index([coordinator_id], map: "coordinator_id")
  @@index([status], map: "idx_projects_status")
  @@map("projects")
}

model Notification {
  id                 Int                  @id @default(autoincrement())
  user_id            Int
  title              String               @db.VarChar(255)
  message            String               @db.Text
  type               String               @db.VarChar(50)
  read               Boolean?             @default(false)
  link               String?              @db.VarChar(255)
  target             String?              @default("all") @db.VarChar(50)
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  updated_at         DateTime             @default(now()) @db.Timestamp(0)
  user               User                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_1")
  user_notifications user_notifications[]

  @@index([created_at], map: "idx_notifications_created_at")
  @@index([read], map: "idx_notifications_read")
  @@index([user_id], map: "idx_notifications_user_id")
  @@map("notifications")
}

model Task {
  id                    Int                @id @default(autoincrement())
  title                 String             @db.VarChar(255)
  description           String             @db.Text
  status                String?            @default("todo") @db.VarChar(50)
  priority              tasks_priority     @default(medium)
  assigned_to           Int
  assigned_users        String?            @db.Text
  created_by            Int
  project_id            Int?
  due_date              DateTime           @db.DateTime(0)
  tags                  String?            @db.Text
  attachments           String?            @db.Text
  created_at            DateTime           @default(now()) @db.DateTime(0)
  updated_at            DateTime           @default(now()) @updatedAt @db.DateTime(0)
  requires_feedback     Boolean?           @default(false)
  feedback_type         String?            @default("text") @db.VarChar(50)
  feedback_text         String?            @db.Text
  feedback_file         String?            @db.VarChar(500)
  feedback_file_name    String?            @db.VarChar(255)
  feedback_file_size    Int?
  feedback_file_type    String?            @db.VarChar(100)
  feedback_submitted_at DateTime?          @db.DateTime(0)
  assigned_type         String?            @default("user") @db.VarChar(50)
  assigned_group        String?            @db.VarChar(255)
  is_recurring          Boolean?           @default(false)
  recurrence_pattern    String?            @db.VarChar(50)
  recurrence_end_date   DateTime?          @db.DateTime(0)
  parent_task_id        Int?
  rating                Int?
  difficulty            Int?
  rating_comment        String?            @db.Text
  rated_at              DateTime?          @db.DateTime(0)
  rated_by              Int?
  pillar                String?            @db.VarChar(255)
  rated_by_name         String?            @db.VarChar(255)
  assignees             TaskAssignee[]
  task_attachments      task_attachments[]
  comments              TaskComment[]
  assignedTo            User               @relation("assignedTasks", fields: [assigned_to], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tasks_ibfk_1")
  createdBy             User               @relation("createdTasks", fields: [created_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tasks_ibfk_2")
  project               Project?           @relation(fields: [project_id], references: [id], onUpdate: Restrict, map: "tasks_ibfk_3")
  parentTask            Task?              @relation("TaskParent", fields: [parent_task_id], references: [id], onUpdate: Restrict, map: "tasks_ibfk_4")
  childTasks            Task[]             @relation("TaskParent")
  ratedBy               User?              @relation("TaskRatedBy", fields: [rated_by], references: [id])

  @@index([created_by], map: "created_by")
  @@index([assigned_to], map: "idx_assigned_to")
  @@index([created_at], map: "idx_created_at")
  @@index([due_date], map: "idx_due_date")
  @@index([priority], map: "idx_priority")
  @@index([status], map: "idx_status")
  @@index([assigned_group], map: "idx_tasks_assigned_group")
  @@index([assigned_type], map: "idx_tasks_assigned_type")
  @@index([difficulty], map: "idx_tasks_difficulty")
  @@index([parent_task_id], map: "idx_tasks_parent_task_id")
  @@index([project_id], map: "idx_tasks_project_id")
  @@index([rated_at], map: "idx_tasks_rated_at")
  @@index([rating], map: "idx_tasks_rating")
  @@index([requires_feedback], map: "idx_tasks_requires_feedback")
  @@map("tasks")
}

model TaskComment {
  id         Int      @id @default(autoincrement())
  task_id    Int
  user_id    Int
  content    String   @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "task_comments_ibfk_1")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "task_comments_ibfk_2")

  @@index([created_at], map: "idx_created_at")
  @@index([task_id], map: "idx_task_id")
  @@index([user_id], map: "idx_user_id")
  @@map("task_comments")
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100)
  role        String       @db.VarChar(100)
  description String?      @db.Text
  icon        String?      @default("Users") @db.VarChar(50)
  status      String?      @default("active") @db.VarChar(20)
  parent_id   Int?
  email       String?      @db.VarChar(255)
  created_at  DateTime     @default(now()) @db.Timestamp(0)
  members     TeamMember[]
  parent      Team?        @relation("TeamParent", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "teams_ibfk_1")
  childTeams  Team[]       @relation("TeamParent")

  @@index([parent_id], map: "parent_id")
  @@map("teams")
}

model TeamMember {
  id         Int      @id @default(autoincrement())
  team_id    Int
  user_id    Int
  role       String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(0)
  is_leader  Boolean? @default(false)
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "team_members_ibfk_1")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "team_members_ibfk_2")

  @@unique([team_id, user_id], map: "unique_team_user")
  @@index([user_id], map: "user_id")
  @@map("team_members")
}

model guide {
  id               Int      @id @default(autoincrement())
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  category         String?  @db.VarChar(50)
  access           String?  @default("all") @db.VarChar(50)
  author_id        Int?
  content          String?  @db.LongText
  created_at       DateTime @default(now()) @db.Timestamp(0)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamp(0)
  is_published     Int?     @default(1) @db.TinyInt
  attachments      String?  @db.LongText
  functional_roles String?  @db.LongText
  author           String?  @db.VarChar(255)
  author_user      User?    @relation(fields: [author_id], references: [id], onUpdate: Restrict, map: "guides_ibfk_1")

  @@index([author_id], map: "author_id")
  @@index([created_at], map: "idx_guides_created_at")
  @@map("guides")
}

model onboarding_data {
  id                   Int      @id @default(autoincrement())
  user_id              Int
  first_name           String   @db.VarChar(100)
  last_name            String   @db.VarChar(100)
  email                String   @db.VarChar(255)
  phone                String?  @db.VarChar(20)
  province             String   @db.VarChar(100)
  development_areas    String   @db.LongText
  skills               String?  @db.LongText
  experience           String?  @default("none") @db.VarChar(50)
  availability         String?  @db.Text
  description          String?  @db.Text
  sala_contacts        String?  @db.LongText
  mp_contacts          String?  @db.LongText
  institution_contacts String?  @db.LongText
  other_contacts       String?  @db.LongText
  completed            Boolean? @default(false)
  created_at           DateTime @default(now()) @db.Timestamp(0)
  updated_at           DateTime @default(now()) @db.Timestamp(0)
  users                User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "onboarding_data_ibfk_1")

  @@index([completed], map: "idx_onboarding_completed")
  @@index([user_id], map: "idx_onboarding_user_id")
}

model refresh_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @db.VarChar(512)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "refresh_tokens_ibfk_1")

  @@index([user_id], map: "user_id")
}

model roles {
  id          Int      @id @default(autoincrement())
  name        String   @unique(map: "name") @db.VarChar(50)
  description String?  @db.Text
  permissions String?  @db.LongText
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
  users       User[]

  @@map("roles")
}

model user_notifications {
  id              Int          @id @default(autoincrement())
  user_id         Int
  notification_id Int
  read            Boolean?     @default(false)
  read_at         DateTime?    @db.Timestamp(0)
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  users           User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_notifications_ibfk_1")
  notifications   Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_notifications_ibfk_2")

  @@unique([user_id, notification_id], map: "unique_user_notification")
  @@index([user_id, read], map: "idx_user_notifications_user_read")
  @@index([notification_id], map: "notification_id")
}

model Vacancy {
  id                            Int                  @id @default(autoincrement())
  title                         String               @db.VarChar(255)
  icon                          String?              @default("Briefcase") @db.VarChar(50)
  description                   String               @db.Text
  responsibilities              String?              @db.LongText
  requirements                  String?              @db.LongText
  nice_to_have                  String?              @db.LongText
  team                          String?              @db.VarChar(100)
  team_id                       String?              @db.VarChar(100)
  pillar                        String?              @db.VarChar(100)
  contact_person_id             Int?
  status                        String?              @default("active") @db.VarChar(50)
  recruitment_type              String?              @default("internal") @db.VarChar(50)
  recruitment_deadline          DateTime?
  recruitment_form_url          String?              @db.VarChar(500)
  recruitment_messenger_contact String?              @db.VarChar(255)
  is_active                     Boolean?             @default(true)
  created_at                    DateTime             @default(now()) @db.Timestamp(0)
  updated_at                    DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  contact_person                User?                @relation(fields: [contact_person_id], references: [id])
  applications                  VacancyApplication[]
  attachments                   VacancyAttachment[]
  questions                     VacancyQuestion[]

  @@index([contact_person_id], map: "vacancies_contact_person_id_fkey")
  @@map("vacancies")
}

model VacancyQuestion {
  id         Int             @id @default(autoincrement())
  vacancy_id Int
  question   String          @db.Text
  type       String          @default("text") @db.VarChar(50)
  required   Boolean?        @default(false)
  options    String?         @db.LongText
  order      Int?            @default(0)
  answers    VacancyAnswer[]
  vacancy    Vacancy         @relation(fields: [vacancy_id], references: [id], onDelete: Cascade)

  @@index([vacancy_id], map: "vacancy_questions_vacancy_id_fkey")
  @@map("vacancy_questions")
}

model VacancyApplication {
  id         Int             @id @default(autoincrement())
  vacancy_id Int
  user_id    Int
  message    String?         @db.Text
  status     String?         @default("pending") @db.VarChar(50)
  created_at DateTime        @default(now()) @db.Timestamp(0)
  answers    VacancyAnswer[]
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vacancy    Vacancy         @relation(fields: [vacancy_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "vacancy_applications_user_id_fkey")
  @@index([vacancy_id], map: "vacancy_applications_vacancy_id_fkey")
  @@map("vacancy_applications")
}

model VacancyAnswer {
  id             Int                @id @default(autoincrement())
  application_id Int
  question_id    Int
  answer         String             @db.Text
  application    VacancyApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)
  question       VacancyQuestion    @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([application_id], map: "vacancy_answers_application_id_fkey")
  @@index([question_id], map: "vacancy_answers_question_id_fkey")
  @@map("vacancy_answers")
}

model VacancyAttachment {
  id          Int      @id @default(autoincrement())
  vacancy_id  Int
  name        String   @db.VarChar(255)
  url         String   @db.VarChar(500)
  size        Int
  type        String?  @db.VarChar(100)
  uploaded_at DateTime @default(now()) @db.Timestamp(0)
  vacancy     Vacancy  @relation(fields: [vacancy_id], references: [id], onDelete: Cascade)

  @@index([vacancy_id], map: "vacancy_attachments_vacancy_id_fkey")
  @@map("vacancy_attachments")
}

model Leave {
  id                Int            @id @default(autoincrement())
  user_id           Int
  type              String         @default("vacation") @db.VarChar(50)
  scope             String         @default("all") @db.VarChar(50)
  affected_teams    String?        @db.LongText
  start_date        DateTime       @db.Date
  end_date          DateTime       @db.Date
  reason            String?        @db.Text
  reason_visibility String         @default("private") @db.VarChar(50)
  status            String         @default("pending") @db.VarChar(50)
  attachments       String?        @db.LongText
  approved_by       String?        @db.VarChar(255)
  approved_at       DateTime?
  created_at        DateTime       @default(now()) @db.Timestamp(0)
  updated_at        DateTime       @default(now()) @updatedAt @db.Timestamp(0)
  comments          LeaveComment[]
  user              User           @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "leaves_user_id_fkey")
  @@map("leaves")
}

model LeaveComment {
  id         Int      @id @default(autoincrement())
  leave_id   Int
  author_id  Int
  content    String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  author     User     @relation(fields: [author_id], references: [id])
  leave      Leave    @relation(fields: [leave_id], references: [id])

  @@index([author_id], map: "leave_comments_author_id_fkey")
  @@index([leave_id], map: "leave_comments_leave_id_fkey")
  @@map("leave_comments")
}

model Idea {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(255)
  description String     @db.Text
  pillar      String     @db.VarChar(50)
  author_id   Int
  author_name String     @db.VarChar(100)
  status      String     @default("pending") @db.VarChar(50)
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(0)
  updated_at  DateTime   @default(now()) @updatedAt @db.Timestamp(0)
  votes       IdeaVote[]

  @@index([is_active], map: "idx_ideas_active")
  @@index([author_id], map: "idx_ideas_author")
  @@index([created_at], map: "idx_ideas_created")
  @@index([pillar], map: "idx_ideas_pillar")
  @@index([status], map: "idx_ideas_status")
  @@map("ideas")
}

model IdeaVote {
  id         Int                  @id @default(autoincrement())
  idea_id    Int
  user_id    Int
  vote_type  idea_votes_vote_type
  created_at DateTime             @default(now()) @db.Timestamp(0)
  updated_at DateTime             @default(now()) @updatedAt @db.Timestamp(0)
  idea       Idea                 @relation(fields: [idea_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_idea_votes_idea")
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_idea_votes_user")

  @@unique([idea_id, user_id], map: "unique_idea_user")
  @@index([idea_id], map: "idx_idea_votes_idea")
  @@index([user_id], map: "idx_idea_votes_user")
  @@map("idea_votes")
}

model SocialMediaMember {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  role       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_social_members_user_id")
  @@map("social_media_members")
}

model ContentCreator {
  id           Int      @id @default(autoincrement())
  user_id      Int      @unique
  availability String
  experience   String
  topics       String
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_content_creators_user_id")
  @@map("content_creators")
}

model Publication {
  id             Int      @id @default(autoincrement())
  title          String
  platform       String
  type           String
  responsible_id Int
  due_date       DateTime
  status         String
  description    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  responsible    User     @relation(fields: [responsible_id], references: [id])

  @@index([responsible_id], map: "idx_publications_responsible")
  @@map("publications")
}

model Material {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  responsible_id Int
  deadline       DateTime @db.Date
  priority       String   @default("medium") @db.VarChar(20)
  stage          String   @default("ideas") @db.VarChar(50)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  is_active      Boolean  @default(true)
  responsible    User     @relation(fields: [responsible_id], references: [id], onDelete: Cascade)

  @@index([responsible_id], map: "idx_materials_responsible")
  @@map("materials")
}

model SocialTask {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  responsible_id Int
  deadline       DateTime
  status         String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  responsible    User     @relation(fields: [responsible_id], references: [id])

  @@index([responsible_id], map: "idx_social_tasks_responsible")
  @@map("social_tasks")
}

model MediaContact {
  id             Int      @id @default(autoincrement())
  name           String
  channel        String
  responsible_id Int
  email          String?
  phone          String?
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  responsible    User     @relation(fields: [responsible_id], references: [id])

  @@index([responsible_id], map: "idx_media_contacts_responsible")
  @@map("media_contacts")
}

model SystemLog {
  id            Int      @id @default(autoincrement())
  user_id       Int
  user_name     String   @db.VarChar(100)
  user_role     String   @db.VarChar(50)
  action_type   String   @db.VarChar(50)
  category      String   @db.VarChar(50)
  endpoint      String   @db.VarChar(255)
  method        String   @db.VarChar(10)
  entity_id     String?  @db.VarChar(50)
  entity_name   String?  @db.VarChar(255)
  changes       String?  @db.LongText
  ip_address    String?  @db.VarChar(45)
  user_agent    String?  @db.LongText
  status        String?  @default("success") @db.VarChar(20)
  error_message String?  @db.Text
  created_at    DateTime @default(now())

  @@index([user_id])
  @@index([action_type])
  @@index([category])
  @@index([created_at])
  @@map("system_logs")
}

model Contribution {
  id         String             @id @default(cuid())
  userId     Int
  amount     Float              @default(0)
  month      Int
  year       Int
  paidAt     DateTime?          @default(now())
  status     ContributionStatus @default(PENDING)
  monthsPaid Int                @default(1)
  title      String?
  externalId String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId])
  @@index([paidAt])
  @@index([status])
  @@index([month, year])
}

model MemberAccess {
  id          Int      @id @default(autoincrement())
  user_id     Int
  access_name String   @db.VarChar(100)
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_access_user")

  @@unique([user_id, access_name], map: "unique_user_access")
  @@index([access_name], map: "idx_member_access_access_name")
  @@index([user_id], map: "idx_member_access_user_id")
  @@map("member_access")
}

model MemberItem {
  id         Int       @id @default(autoincrement())
  user_id    Int
  name       String    @db.VarChar(100)
  value      Decimal?  @db.Decimal(10, 2)
  notes      String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_member_items_user_id")

  @@index([name], map: "idx_member_items_name")
  @@index([user_id], map: "idx_member_items_user_id")
  @@map("member_items")
}

model TaskAssignee {
  id           Int                    @id @default(autoincrement())
  task_id      Int
  user_id      Int
  status       task_assignees_status? @default(todo)
  started_at   DateTime?              @db.DateTime(0)
  completed_at DateTime?              @db.DateTime(0)
  updated_at   DateTime?              @default(now()) @updatedAt @db.DateTime(0)
  created_at   DateTime?              @default(now()) @db.DateTime(0)
  task         Task                   @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "task_assignees_ibfk_1")
  user         User                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "task_assignees_ibfk_2")

  @@unique([task_id, user_id], map: "unique_task_user")
  @@index([user_id], map: "user_id")
  @@map("task_assignees")
}

model task {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  assigned_to    Int?
  assigned_users String?  @db.Text
  status         String   @default("pending") @db.VarChar(50)
  created_at     DateTime @default(now()) @db.Timestamp(0)
  updated_at     DateTime @default(now()) @db.Timestamp(0)
  users          User?    @relation(fields: [assigned_to], references: [id], map: "Task_assigned_to_fkey")

  @@index([assigned_to], map: "Task_assigned_to_fkey")
}

model task_attachments {
  id          Int      @id @default(autoincrement())
  task_id     Int
  file_name   String   @db.VarChar(255)
  file_path   String   @db.VarChar(500)
  file_size   Int
  mime_type   String   @db.VarChar(100)
  uploaded_by Int
  created_at  DateTime @default(now()) @db.DateTime(0)
  tasks       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "task_attachments_ibfk_1")
  users       User     @relation(fields: [uploaded_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "task_attachments_ibfk_2")

  @@index([task_id], map: "idx_task_id")
  @@index([uploaded_by], map: "idx_uploaded_by")
}

enum ContributionStatus {
  PAID
  PENDING
  SUSPENDED
  OVERDUE
}

enum idea_votes_vote_type {
  up
  down
}

enum task_assignees_status {
  todo
  in_progress
  review
  done
}

enum tasks_priority {
  low
  medium
  high
  urgent
}
